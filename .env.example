# Supabase (Project Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.supabase.com:5432/postgres"

# Email (https://resend.com > API Keys)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
INQUIRY_TO_EMAIL="info@abcrentacar.ba"
INQUIRY_FROM_EMAIL="ABC Rent a Car <rezervacije@abcrentacar.ba>"

# Public
NEXT_PUBLIC_SITE_URL="https://abcrentacar.ba"

# Supabase Storage (admin upload slika vozila)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"

# Admin panel lozinka
ADMIN_PASSWORD="promijeni-me"

# Vercel cron (ciscenje isteklih upita)
CRON_SECRET="dugi-nasumicni-string"

# Telegram obavijesti vlasniku (opcionalno)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

GOOGLE_PLACES_API_KEY=""
